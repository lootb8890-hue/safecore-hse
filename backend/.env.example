# SafeCore HSE Platform - Environment Variables

# Application
PORT=3000
NODE_ENV=production
API_PREFIX=api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safecore_hse?schema=public"

# Redis (Caching & Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & Authentication (Zero Trust Security)
JWT_SECRET="SafeCoreEnterpriseJwtSecretKey2026!superSecret!DoNotExposeInProd"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Storage Configuration
OBJECT_STORAGE_PROVIDER=local
STORAGE_BASE_URL="http://localhost:3000/storage"
AWS_S3_BUCKET=safecore-enterprise-assets
AWS_REGION=us-east-1

# AI Module Credentials
AI_API_KEY="AIzaSy...YourEnterpriseGeminiOrOpenAIKey"
AI_MODEL="gemini-1.5-pro"
